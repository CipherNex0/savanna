generator client {
  provider = "prisma-client"
  output = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  NEW
  CONTACTED
  PLANNING
  CONFIRMED
  CANCELLED
}

model JourneyRequest {
  id            String        @id @default(cuid())
  name          String
  email         String
  phone         String?
  departureDate DateTime?
  returnDate    DateTime?
  destination   String
  experience    String
  duration      String
  travelStyle   String
  accommodation String
  message       String?
  status        RequestStatus @default(NEW)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}